# ============================================================
# Clinical-AI - environment variables
# Copy to backend/.env and fill in. Never commit the real .env.
# ============================================================

# --- Database ---------------------------------------------------------------
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=clinical_ai

# --- Authentication ---------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=30

# --- Application ------------------------------------------------------------
DEBUG=false
# DEBUG=true also returns the password-reset token in the API response so the
# flow can be completed locally without an email provider configured.
# Never enable this in production.

# --- CORS -------------------------------------------------------------------
# Only relevant for Flutter *web* builds. Android and iOS are not browsers and
# send no Origin header, so CORS plays no part there. Flutter web picks a random
# port unless you pin one, so run it with --web-port=8080 and keep this in sync.
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# --- Translation (optional) -------------------------------------------------
# none          English only; other languages show untranslated text with a note
# indictrans2   AI4Bharat, self-hosted, no external API and no key needed
# google        Google Cloud Translation (uses GOOGLE_APPLICATION_CREDENTIALS)
# azure         Azure AI Translator (needs key + region)
TRANSLATION_PROVIDER=none
TRANSLATION_API_KEY=
TRANSLATION_REGION=

# The mobile app takes its API URL at build time, not from a .env file:
#   flutter run --dart-define=API_BASE_URL=http://127.0.0.1:8000/api
